# examples/hub-cashier-next/.env.example
# Copy to .env.local (gitignored). Never commit real secrets.
#
# SECURITY:
# - Never put sk_ or whsec_ values behind NEXT_PUBLIC_ (browser-exposed).
# - Never log full secrets.
# - Checkout fails with PAYMENTS_NOT_CONFIGURED until Ops enables BYOK
#   (Billplz/Stripe/CHIP/Razorpay) for the provisioned workspace.

# Hub API base INCLUDING /api/v1 (canonical local port 8080)
LAZUAR_HUB_BASE_URL=http://localhost:8080/api/v1

# Machine API key — from provision api_key.plain_key (once) or Ops mint.
# Prefer LAZUAR_SK_TEST_KEY; LAZUAR_API_KEY is an alias.
LAZUAR_SK_TEST_KEY=sk_test_replace_me
# LAZUAR_API_KEY=sk_test_replace_me

# Outbound webhook signing secret — from provision webhook.secret_key (once).
# Use the FULL string including the whsec_ prefix as HMAC key material.
LAZUAR_WEBHOOK_SECRET=whsec_replace_me

# Public base URL of THIS sample (absolute success/cancel URLs + provision webhook host).
# Port 3020 is locked for this sample. Prefer 127.0.0.1 for Hub→sample local callbacks.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3020

# Optional defaults
# DEFAULT_CURRENCY=MYR
# EXTERNAL_PRODUCT=sample-shop
# EXTERNAL_ORG_ID=local-dev-1

# ---------------------------------------------------------------------------
# Provision helper only (NOT required for runtime checkout / webhook path).
# Use with scripts that call POST /one/integrations/workspaces/provision.
# Never expose these to the browser.
# ---------------------------------------------------------------------------
# INTEGRATOR_PROVISION_SECRET=
# EXTERNAL_PRODUCT=sample-shop
# EXTERNAL_ORG_ID=local-dev-1
# WEBHOOK_URL=http://127.0.0.1:3020/webhooks/hub/payments
