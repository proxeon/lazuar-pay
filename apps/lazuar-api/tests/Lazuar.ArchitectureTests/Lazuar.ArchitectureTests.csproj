<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the main API project so tests can evaluate architectural boundaries -->
    <ProjectReference Include="..\..\src\Lazuar.Api\Lazuar.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embeds the static test vector into the compiled test assembly -->
    <EmbeddedResource Include="TestData\lhdn-golden-master.json" />
  </ItemGroup>

</Project>
