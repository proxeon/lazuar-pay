{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=lazuar_mvp;Username=postgres;Password=postgres;Maximum Pool Size=50;Timeout=15;",
    "TenantConnection": "Host=localhost;Port=5432;Database=lazuar_mvp;Username=postgres;Password=postgres;Maximum Pool Size=50;Timeout=15;",
    "MessagingConnection": "Host=localhost;Port=5432;Database=lazuar_mvp;Username=postgres;Password=postgres;Maximum Pool Size=20;Timeout=10;"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "lazuar-api",
    "Audience": "lazuar-clients",
    "ExpiryHours": 24
  },
  "Kms": {
    "MasterKey": ""
  },
  "Security": {
    "PasswordWorkFactor": 11
  },
  "Resend": {
    "ApiKey": "",
    "SenderEmail": "",
    "WebhookSecret": ""
  },
  "App": {
    "ClientUrl": "http://localhost:3004",
    "ApiBaseUrl": "http://localhost:8080/api/v1",
    "CorsOrigins": "http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3020,http://localhost:3021,http://localhost:8080,http://localhost:8090,http://localhost:9080"
  },
  "OpenAI": {
    "ApiKey": ""
  },
  "Ai": {
    "Provider": "OPENROUTER",
    "Model": "qwen/qwen3.7-max",
    "MaxToolIterations": 7,
    "ProviderKeys": {
      "OPENROUTER": ""
    }
  },
  "Lhdn": {
    "ReferenceDataPath": "lhdn_docs/codes"
  },
  "Credits": {
    "Costs": {
      "WhatsAppSend": 2,
      "LhdnSubmit": 3
    },
    "Packages": [
      {
        "AmountMyr": 50,
        "Credits": 500
      },
      {
        "AmountMyr": 100,
        "Credits": 1100
      },
      {
        "AmountMyr": 200,
        "Credits": 2500
      }
    ],
    "StarterGrant": 50
  },
  "Messaging": {
    "WhatsAppEnabled": false
  },
  "Workers": {
    "OutboundWebhookInterval": "00:00:10",
    "BroadcastFanoutInterval": "00:00:10",
    "LhdnSubmissionInterval": "00:00:05",
    "LhdnStatusPollingInterval": "00:00:10",
    "BillingEngineInterval": "01:00:00",
    "DunningEngineInterval": "01:00:00",
    "ClaimLeaseDuration": "00:02:00"
  },
  "Observability": {
    "LhdnStuckThreshold": "01:00:00",
    "MetricsRefreshInterval": "00:00:30",
    "OutboxLagReadyThreshold": null
  },
  "ApiKeyMigration": {
    "Enabled": false,
    "DryRun": true,
    "BatchSize": 500
  }
}
