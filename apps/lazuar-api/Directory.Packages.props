<Project>
  <ItemGroup>
    <!-- Entity Framework Core & PostgreSQL -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0-preview.1.25080.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0-preview.1.25080.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0-preview.1.25080.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0-preview.1" />
    
    <!-- Dapper & Database Utilities -->
    <PackageVersion Include="Dapper" Version="2.1.35" />
    
    <!-- MediatR (CQRS & Domain Events) -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    
    <!-- FluentValidation -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    
    <!-- Security, Authentication & Cryptography -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0-preview.1.25120.3" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
    
    <!-- Storage & Cloud Services -->
    <PackageVersion Include="AWSSDK.S3" Version="3.7.408" />
    
    <!-- Logging & Diagnostics -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.0" />
    
    <!-- Testing Libraries -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NUnit" Version="4.3.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.1" />
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- Payment Gateways -->
    <PackageVersion Include="Stripe.net" Version="48.0.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- AI & Ops -->
    <PackageVersion Include="OpenAI" Version="2.1.0" />
  </ItemGroup>
</Project>
