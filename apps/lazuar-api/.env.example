# lazuar-api — every key Config::from_env reads.
# Copy to .env (gitignored). Do **not** use Pay__ConnectionString; C# binds ConnectionStrings__Pay.

# --- laptop (Development) ---
ASPNETCORE_ENVIRONMENT=Development
LISTEN_ADDR=127.0.0.1:8095
ConnectionStrings__Pay=host=localhost port=5435 user=postgres password=postgres dbname=lazuar_pay
Pay__PublicBaseUrl=http://localhost:8095
Pay__CheckoutBaseUrl=http://localhost:5179
Pay__CorsOrigins=http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179
One__BaseUrl=http://localhost:8080/api/v1
One__TimeoutSeconds=5
Pay__StartMaxPerMinute=20
Pay__ReservationTtlMinutes=30
Pay__StripeWebhookSecret=whsec_test_local
Pay__TestWebhookSecret=test_whsec_local
Pay__OneWebhookSecret=
Pay__Solana__Cluster=devnet
Pay__Solana__RpcUrl=
Pay__WrapKey=
One__ApiKey=
One__WorkerOrgId=
RUST_LOG=info

# --- Production (uncomment and fill; boot fails closed without these) ---
# ASPNETCORE_ENVIRONMENT=Production
# LISTEN_ADDR=0.0.0.0:8081
# ConnectionStrings__Pay=host=pay-db port=5432 user=postgres password=postgres dbname=lazuar_pay sslmode=require
# Pay__WrapKey=                    # 32-byte standard base64
# Pay__PublicBaseUrl=https://pay.example
# Pay__CheckoutBaseUrl=https://checkout.example
# Pay__CorsOrigins=https://merchant.example,https://checkout.example
# One__BaseUrl=https://one.example/api/v1
# One__ApiKey=lzr_sk_              # required with One__WorkerOrgId when set
# One__WorkerOrgId=
# One__TimeoutSeconds=5
# Pay__Solana__Cluster=mainnet-beta
# Pay__Solana__RpcUrl=https://     # paid https RPC; not api.mainnet-beta.solana.com
# Pay__StartMaxPerMinute=20
# Pay__ReservationTtlMinutes=30
# Pay__StripeWebhookSecret=
# Pay__TestWebhookSecret=
# Pay__OneWebhookSecret=
# RUST_LOG=info
