# lazuar-pay-rs production env. Copy to pay-rs.env.production on the
# server, fill every value, chmod 600. Never commit the filled file.
# Generate secrets with: openssl rand -base64 32

# Supabase direct connection (port 5432, NOT the 6543 pooler — prepared
# statements break under transaction pooling). URL-encode the password.
# e.g. postgres://postgres:PASSWORD@db.REF.supabase.co:5432/lazuar_pay?sslmode=require
ConnectionStrings__Pay=postgres://postgres:__fill__@db.__fill__.supabase.co:5432/lazuar_pay?sslmode=require

# 32-byte base64 wrap key for the BYOK vault. Losing this bricks the vault
# (keys must be re-entered) — keep an off-host copy. openssl rand -base64 32
Pay__WrapKey=__fill__

# Live One. Must be public https in Production (ThrowIf rejects localhost).
One__BaseUrl=https://one.lazuar.com/api/v1

# Public buyer-return origin (success/cancel URLs) and Billplz callback base.
# Billplz rejects non-public callback URLs at start time.
Pay__CheckoutBaseUrl=https://store.lazuar.com
Pay__PublicBaseUrl=https://pay.lazuar.com

# Browser origins allowed to call Pay. Must include the checkout origin.
Pay__CorsOrigins=https://store.lazuar.com

# Gates /metrics (empty = open; set to require a bearer token).
Pay__MetricsToken=__fill__

# Public start rate limit per pay token (per process; default 20).
# Pay__StartMaxPerMinute=20

# Solana Pay (optional). Production requires mainnet-beta + a paid HTTPS RPC.
# Pay__Solana__Cluster=mainnet-beta
# Pay__Solana__RpcUrl=https://__fill__

# One-shop HMAC fallback for POST /v1/one/webhooks. Multi-shop: per-org PUT
# /v1/orgs/{orgId}/one-webhook instead (preferred; this stays empty).
# Pay__OneWebhookSecret=
