# Lazuar Hub — local dev gateway (prod-like path map)
# Listen: http://localhost:9080 (published by docker-compose.dev-proxy.yml)
#
# Caddy runs in Docker; frontends/API run on the host (mprocs / task dev).
# Upstreams use host.docker.internal (Docker Desktop macOS/Windows;
# compose sets host-gateway for Linux).
#
# Admin: handle_path strips /admin so Vite base=/admin/ asset URLs resolve
#        the same way as deploy/prod/Caddyfile.
# Portal/docs: path prefix preserved (Next basePath).
# Ops: catch-all at /.
#
# Run: task proxy

:9080 {
	encode gzip

	handle /health {
		reverse_proxy host.docker.internal:8080
	}

	handle /api/* {
		reverse_proxy host.docker.internal:8080
	}

	# Portal (Next basePath=/portal)
	handle /portal* {
		reverse_proxy host.docker.internal:3004
	}

	# Developer docs (Next basePath=/docs)
	handle /docs* {
		reverse_proxy host.docker.internal:3002
	}

	# Superadmin (Vite base=/admin/) — strip prefix like prod
	@adminExact path /admin
	redir @adminExact /admin/ permanent
	handle_path /admin/* {
		reverse_proxy host.docker.internal:3005
	}

	# Ops creator console at /
	handle {
		reverse_proxy host.docker.internal:3003
	}
}
