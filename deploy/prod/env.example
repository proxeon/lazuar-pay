# Copy on server:  cp env.example .env && chmod 600 .env
# Never commit real .env.
#
# Neon: convert postgresql:// URI → Npgsql:
#   Host=ep-xxx-pooler.region.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=...;SSL Mode=Require;Trust Server Certificate=true

VERSION=latest

ASPNETCORE_ENVIRONMENT=Production

# Same Neon string for all module DbContexts (multi-schema in one DB)
ConnectionStrings__Default=
ConnectionStrings__TenantConnection=
ConnectionStrings__MessagingConnection=

# JWT — openssl rand -base64 48
Jwt__Secret=change-me-jwt-secret-minimum-32-characters
Jwt__Issuer=lazuar-api
Jwt__Audience=lazuar-clients
Jwt__ExpiryHours=24

# Public URLs (path-based hub)
App__ClientUrl=https://hub.lazuar.com/portal
App__OpsUrl=https://hub.lazuar.com
# Public API base Billplz/Stripe can reach (includes /api/v1).
# Ops alias in runbooks: HUB_PUBLIC_URL → same value as App__ApiBaseUrl.
# Local tunnel example: https://{hub-ngrok}/api/v1
# Billplz per-bill callback: {App__ApiBaseUrl}/webhooks/payments/billplz/{tenantId}
App__ApiBaseUrl=https://hub.lazuar.com/api/v1
# Required in Production/Staging — empty fails boot (does not AllowAnyOrigin).
App__CorsOrigins=https://hub.lazuar.com

# Browser public API (also baked into portal image at build)
NEXT_PUBLIC_API_URL=https://hub.lazuar.com/api/v1
# Portal /accept-invite 302 target (baked at portal image build)
NEXT_PUBLIC_OPS_URL=https://hub.lazuar.com

# Optional platform admin seed (first boot)
# PLATFORM_ADMIN_EMAILS=you@example.com
# PLATFORM_ADMIN_PASSWORD=

# Integrator workspace provision (any integrator; Aura is one client). High-entropy secret; never expose to browsers.
# Header: X-Lazuar-Provision-Key: <secret>  OR  Authorization: Bearer <secret>
# openssl rand -base64 48
# INTEGRATOR_PROVISION_SECRET=

# Tenant credential encryption at rest (AES) — required for payment/LHDN/Resend secrets.
# Prefer a dedicated key; falls back to Jwt__Secret only if unset.
# openssl rand -base64 32
Kms__MasterKey=change-me-kms-master-key-minimum-32-characters

# Optional: Resend (platform-level email; leave empty to use tenant BYOK only)
# Resend__ApiKey=
# Resend__SenderEmail=noreply@lazuar.com

# Messaging honesty: WhatsApp channel off until Meta Cloud (or other) is wired
Messaging__WhatsAppEnabled=false

# Optional: R2
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_PUBLIC_DEV_URL=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=

# Optional: AI
# Ai__Provider=OPENROUTER
# Ai__ProviderKeys__OPENROUTER=
