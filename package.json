{
  "name": "lazuar",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=!@examples/*",
    "dev": "turbo run dev --filter=!@examples/*",
    "lint": "turbo run lint --filter=!@examples/*",
    "test": "turbo run test --filter=!@examples/*",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types --filter=!@examples/*",
    "docs:dev": "pnpm --filter lazuar-docs dev",
    "docs:build": "pnpm --filter lazuar-docs build",
    "docs:preview": "pnpm --filter lazuar-docs preview",
    "example:cashier": "pnpm --filter @examples/hub-cashier-next dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=18"
  }
}
